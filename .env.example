# Admin token for POST /admin/reload and /admin/rollback (local dev only)
FRAUDWATCH_ADMIN_TOKEN=local-dev-token
# Artifact / registry locations (defaults: ./artifacts, ./data in repo)
# FRAUDWATCH_ARTIFACTS=/path/to/artifacts
# FRAUDWATCH_DATA=/path/to/data
# Optional MLflow tracking (only used if mlflow is installed)
# MLFLOW_TRACKING_URI=file:./mlruns
